VITE_CONTACT_PHONE=+52 000 000 0000
VITE_CONTACT_EMAIL=admin@example.com

VITE_SCHOOL_ADDRESS=School Address
VITE_MAP_LAT=0.0
VITE_MAP_LNG=0.0
VITE_SOCIAL_INSTAGRAM=https://instagram.com/example
VITE_SHOW_TEACHERS_SECTION=false
VITE_SHOW_GALLERY_SECTION=true
VITE_CONTACT_EMAIL_ENDPOINT=https://example.com/webhook
VITE_CTA_MODE=whatsapp

VITE_UMAMI_HOST=https://analytics.example.com
VITE_UMAMI_USERNAME=user
VITE_UMAMI_PASSWORD=password
VITE_UMAMI_SITE_ID=site-id

# Database connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL="postgres://postgres:password@host:port/dbname?sslmode=disable"

# Email Queue Configuration (BullMQ + Redis)
USE_EMAIL_QUEUE=true
REDIS_URL="redis://127.0.0.1:6379"
WORKER_CONCURRENCY=5

# Deepstream Realtime Config
DEEPSTREAM_URL=https://realtime.example.com/api
NEXT_PUBLIC_DEEPSTREAM_URL=wss://realtime.example.com
VITE_DEEPSTREAM_URL=wss://realtime.example.com

# SaaS Pricing Configuration
VITE_PRICING_ENVIRONMENT_TIER1=25
VITE_PRICING_ENVIRONMENT_TIER2=10
VITE_PRICING_FINANCES=12
VITE_PRICING_NEWSLETTER=3.99
VITE_PRICING_WEBSITE_BUILDER=18
VITE_PRICING_FORMS=9
VITE_PRICING_PIPELINES=9
VITE_PRICING_STORAGE_10GB=5

# Core Mandatory Modules
VITE_PRICING_WAITLIST=1
VITE_PRICING_PORTAL_PARENTS=5
VITE_PRICING_PORTAL_TEACHERS=5
VITE_PRICING_PROGRESS=1
VITE_PRICING_ATTENDANCE=1
VITE_PRICING_CALENDAR=1

# Transactional Email & Resend Delivery Configuration
RESEND_API_KEY=""
DEFAULT_EMAIL_DOMAIN="montessorinexus.com"
EMAIL_SENDER_DOMAIN="montessorinexus.com"

# Super Admin Configuration
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_this_password

# Multi-tenant Storage Configuration
# Drivers: "s3" | "minio" | "local"
# Default for system is S3. Each school's files are isolated in "schools/<schoolId>/...".
STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="montessorinexus-storage"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false
STORAGE_LOCAL_ROOT="/app/storage"

